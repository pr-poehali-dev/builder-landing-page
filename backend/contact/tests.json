{
  "tests": [
    {
      "name": "Save contact request with all fields",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "name": "Иван Иванов",
        "phone": "+7 (999) 123-45-67",
        "email": "ivan@example.com",
        "message": "Хочу построить дом"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "success": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Save contact request without email and message",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "name": "Петр Петров",
        "phone": "+7 (911) 222-33-44"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "success": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Reject request without name",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "phone": "+7 (911) 222-33-44",
        "message": "Test"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    }
  ]
}